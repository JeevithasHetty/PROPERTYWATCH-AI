# PropertyWatch AI - Environment Configuration Example

# Operational Mode
DEMO_MODE=true

# Security
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database
DATABASE_URL=sqlite:///./propertywatch.db

# OpenStreetMap Nominatim Geocoding
NOMINATIM_USER_AGENT=PropertyWatchAI-App/1.0 (contact@propertywatch.local)

# Copernicus Data Space Ecosystem / Sentinel Hub (Optional for Live API Mode)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
SENTINEL_INSTANCE_ID=

# AI Authenticity Detection Provider (Optional)
AUTHENTICITY_API_URL=
AUTHENTICITY_API_KEY=

# LLM Evidence Summarizer (Optional: OpenAI, Anthropic, or local proxy)
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
