# PropertyWatch AI - copy to backend/.env
DEMO_MODE=true                # true = labelled synthetic demo imagery/records; false = live providers only
SECRET_KEY=                   # required when DEMO_MODE=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=sqlite:///./propertywatch.db
BOOTSTRAP_ADMIN_EMAIL=        # live mode only: first admin account (no demo users are created in live mode)
BOOTSTRAP_ADMIN_PASSWORD=

# --- Geocoding (OpenStreetMap Nominatim, restricted to India) ---
NOMINATIM_USER_AGENT=PropertyWatchAI/1.0 (your-real-contact@yourdomain.in)   # Nominatim policy: identify yourself

# --- Satellite: Copernicus Data Space (free). Dashboard > OAuth clients > create client ---
SATELLITE_PROVIDER=auto      # auto | copernicus | gee
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# --- Satellite: Google Earth Engine (optional; pip install earthengine-api) ---
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY=      # path to the service-account JSON key

# --- Trained model weights (ONNX). Missing => model reported UNAVAILABLE ---
LEVIR_CD_MODEL_PATH=          # default: <project>/models/levir_cd.onnx
ROOFTOP_MODEL_PATH=           # default: <project>/models/rooftop_yolo.onnx
ROOFTOP_MODEL_CLASSES=solar_panel

# --- Automated monitoring ---
MONITORING_ENABLED=true
MONITORING_INTERVAL_HOURS=24
MONITORING_MAX_CLOUD_COVER=20
MONITORING_ALERT_CHANGE_SCORE=8.0
MONITORING_RUN_IN_DEMO=false
# Optional e-mail notifications (in-app notifications are always created)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional AI authenticity / LLM summariser ---
AUTHENTICITY_API_URL=
AUTHENTICITY_API_KEY=
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
